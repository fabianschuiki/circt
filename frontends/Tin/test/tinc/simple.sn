// RUN: tinc %s | FileCheck %s

// CHECK: hw.module @Foo(
// CHECK-SAME: in %a : i42
// CHECK-SAME: in %b : i42
// CHECK-SAME: in %c : i42
// CHECK-SAME: in %d : i42
mod Foo(in a: int<42>, in b: int<42>, in c: int<42>, in d: int<42>) {
  // Stray semicolons are ignored.
  ;

  // CHECK: hw.constant 0 : i0
  0;
  // CHECK: hw.constant true
  1;
  // CHECK: hw.constant -22 : i6
  42;
  // CHECK: hw.constant 42 : i16
  42i16;
  // CHECK: hw.constant -24 : i10
  1_000;
  // CHECK: hw.constant -6 : i4
  0b0000_1010;
  // CHECK: hw.constant -1 : i9
  0o777;
  // CHECK: hw.constant -14434577 : i25
  0x0123_beef;

  // CHECK: hw.constant -21 : i6
  (43);

  // CHECK: [[ZERO:%.+]] = hw.constant 0 : i42
  // CHECK: comb.sub [[ZERO]], %a : i42
  -a;
  // CHECK: [[ONES:%.+]] = hw.constant -1 : i42
  // CHECK: comb.xor [[ONES]], %a : i42
  !a;

  // CHECK: comb.and %a, %b : i42
  a & b;
  // CHECK: comb.or %a, %b : i42
  a | b;
  // CHECK: comb.xor %a, %b : i42
  a ^ b;
  // CHECK: comb.add %a, %b : i42
  a + b;
  // CHECK: comb.sub %a, %b : i42
  a - b;
  // CHECK: comb.mul %a, %b : i42
  a * b;
  // CHECK: comb.divu %a, %b : i42
  a / b;
  // CHECK: comb.modu %a, %b : i42
  a % b;
  // CHECK: comb.shl %a, %b : i42
  a << b;
  // CHECK: comb.shru %a, %b : i42
  a >> b;
  // CHECK: comb.icmp eq %a, %b : i42
  a == b;
  // CHECK: comb.icmp ne %a, %b : i42
  a != b;
  // CHECK: comb.icmp ult %a, %b : i42
  a < b;
  // CHECK: comb.icmp ugt %a, %b : i42
  a > b;
  // CHECK: comb.icmp ule %a, %b : i42
  a <= b;
  // CHECK: comb.icmp uge %a, %b : i42
  a >= b;

  // CHECK: [[TMP:%.+]] = comb.mul %b, %c
  // CHECK: comb.add %a, [[TMP]]
  a + b * c;
  // CHECK: [[TMP:%.+]] = comb.mul %a, %b
  // CHECK: comb.add [[TMP]], %c
  a * b + c;
  // CHECK: [[TMP1:%.+]] = comb.mul %a, %b
  // CHECK: [[TMP2:%.+]] = comb.mul %c, %d
  // CHECK: comb.add [[TMP1]], [[TMP2]]
  a * b + c * d;

  // Left-associativity.
  // CHECK: [[TMP:%.+]] = comb.sub %a, %b
  // CHECK: comb.add [[TMP]], %c
  a - b + c;
}

// CHECK: hw.module @Bar()
mod Bar() {
}
