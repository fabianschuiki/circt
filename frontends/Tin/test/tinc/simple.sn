// RUN: tinc %s | FileCheck %s

// CHECK: hw.module @Foo()
mod Foo() {
  // Stray semicolons are ignored.
  ;

  // CHECK: hw.constant 0 : i0
  0;
  // CHECK: hw.constant true
  1;
  // CHECK: hw.constant -22 : i6
  42;
  // CHECK: hw.constant 42 : i16
  42i16;
  // CHECK: hw.constant -24 : i10
  1_000;
  // CHECK: hw.constant -6 : i4
  0b0000_1010;
  // CHECK: hw.constant -1 : i9
  0o777;
  // CHECK: hw.constant -14434577 : i25
  0x0123_beef;

  // CHECK: hw.constant -21 : i6
  (43);

  // CHECK: [[TMP:%.+]] = hw.constant -22 : i6
  // CHECK: [[ZERO:%.+]] = hw.constant 0 : i6
  // CHECK: comb.sub [[ZERO]], [[TMP]] : i6
  -42;
  // CHECK: [[TMP:%.+]] = hw.constant -22 : i6
  // CHECK: [[ONES:%.+]] = hw.constant -1 : i6
  // CHECK: comb.xor [[ONES]], [[TMP]] : i6
  !42;

  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.and [[A]], [[B]] : i6
  42 & 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.or [[A]], [[B]] : i6
  42 | 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.xor [[A]], [[B]] : i6
  42 ^ 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.add [[A]], [[B]] : i6
  42 + 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.sub [[A]], [[B]] : i6
  42 - 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.mul [[A]], [[B]] : i6
  42 * 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.divu [[A]], [[B]] : i6
  42 / 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.modu [[A]], [[B]] : i6
  42 % 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.shl [[A]], [[B]] : i6
  42 << 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.shru [[A]], [[B]] : i6
  42 >> 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp eq [[A]], [[B]] : i6
  42 == 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp ne [[A]], [[B]] : i6
  42 != 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp ult [[A]], [[B]] : i6
  42 < 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp ugt [[A]], [[B]] : i6
  42 > 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp ule [[A]], [[B]] : i6
  42 <= 43;
  // CHECK: [[A:%.+]] = hw.constant -22 : i6
  // CHECK: [[B:%.+]] = hw.constant -21 : i6
  // CHECK: comb.icmp uge [[A]], [[B]] : i6
  42 >= 43;

  // CHECK: [[A:%.+]] = hw.constant -22
  // CHECK: [[B:%.+]] = hw.constant -21
  // CHECK: [[C:%.+]] = hw.constant -20
  // CHECK: [[TMP:%.+]] = comb.mul [[B]], [[C]]
  // CHECK: comb.add [[A]], [[TMP]]
  42 + 43 * 44;
  // CHECK: [[A:%.+]] = hw.constant -22
  // CHECK: [[B:%.+]] = hw.constant -21
  // CHECK: [[TMP:%.+]] = comb.mul [[A]], [[B]]
  // CHECK: [[C:%.+]] = hw.constant -20
  // CHECK: comb.add [[TMP]], [[C]]
  42 * 43 + 44;
  // CHECK: [[A:%.+]] = hw.constant -22
  // CHECK: [[B:%.+]] = hw.constant -21
  // CHECK: [[TMP1:%.+]] = comb.mul [[A]], [[B]]
  // CHECK: [[C:%.+]] = hw.constant -20
  // CHECK: [[D:%.+]] = hw.constant -19
  // CHECK: [[TMP2:%.+]] = comb.mul [[C]], [[D]]
  // CHECK: comb.add [[TMP1]], [[TMP2]]
  42 * 43 + 44 * 45;
}

// CHECK: hw.module @Bar()
mod Bar() {
}
