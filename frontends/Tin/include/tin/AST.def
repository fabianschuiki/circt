#ifndef AST_ANY
#define AST_ANY(NAME)
#endif

#ifndef AST_ITEM
#define AST_ITEM(NAME) AST_ANY(NAME##Item)
#endif

#ifndef AST_STMT
#define AST_STMT(NAME) AST_ANY(NAME##Stmt)
#endif

#ifndef AST_EXPR
#define AST_EXPR(NAME) AST_ANY(NAME##Expr)
#endif

#ifndef AST_TYPE
#define AST_TYPE(NAME) AST_ANY(NAME##Type)
#endif

#ifndef AST_UNARY
#define AST_UNARY(NAME, TOKEN)
#endif

#ifndef AST_BINARY
#define AST_BINARY(NAME, TOKEN, PREC)
#endif

AST_ITEM(Mod)

AST_STMT(Empty)
AST_STMT(Expr)

AST_EXPR(NumLit)
AST_EXPR(Paren)
AST_EXPR(Unary)
AST_EXPR(Binary)

AST_UNARY(Neg, Sub)
AST_UNARY(Not, Emark)

AST_BINARY(And, And, And)
AST_BINARY(Or, Or, Or)
AST_BINARY(Xor, Xor, Xor)
AST_BINARY(Add, Add, Add)
AST_BINARY(Sub, Sub, Add)
AST_BINARY(Mul, Mul, Mul)
AST_BINARY(Div, Div, Mul)
AST_BINARY(Mod, Mod, Mul)
AST_BINARY(Shl, Shl, Shift)
AST_BINARY(Shr, Shr, Shift)

AST_BINARY(Eq, Eq, Eq)
AST_BINARY(Neq, Neq, Eq)
AST_BINARY(Lt, Lt, Rel)
AST_BINARY(Gt, Gt, Rel)
AST_BINARY(Geq, Geq, Rel)
AST_BINARY(Leq, Leq, Rel)

AST_TYPE(Int)

#undef AST_ANY
#undef AST_ITEM
#undef AST_STMT
#undef AST_EXPR
#undef AST_TYPE
#undef AST_UNARY
#undef AST_BINARY
