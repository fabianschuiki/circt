#ifndef AST_ANY
#define AST_ANY(NAME)
#endif

#ifndef AST_ITEM
#define AST_ITEM(NAME) AST_ANY(NAME##Item)
#endif

AST_ITEM(Mod)

#undef AST_ANY
#undef AST_ITEM
